{
  "name": "nora-backtest-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:edu": "npm --prefix ../../edu/frontend run dev",
    "dev:coin": "vite --config vite.config.js",
    "build": "npm run build:coin",
    "build:edu": "npm --prefix ../../edu/frontend run build",
    "build:coin": "vite build --config vite.config.js",
    "build:all": "npm run build:coin && npm run build:edu",
    "preview": "vite preview",
    "api:check": "node scripts/checkApi.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "katex": "^0.19.0",
    "lightweight-charts": "4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
