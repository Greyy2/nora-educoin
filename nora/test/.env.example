# OKX DEX (on-chain) credentials
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEX_BASE_URL=https://web3.okx.com
# optional
OKX_DEX_TIMEOUT=30
OKX_DEX_LIMIT=50
OKX_DEX_PAGE_DELAY_SEC=1.0

# Nora data source
NORA_DATA_SOURCE=auto
NORA_LOCAL_DATA_ROOT=/home/ubuntu/norabt/nora/data

# GeckoTerminal public DEX API (no key required)
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_TIMEOUT=30
GECKOTERMINAL_LIMIT=50
GECKOTERMINAL_PAGE_DELAY_SEC=12.0
GECKOTERMINAL_RETRIES=5
GECKOTERMINAL_RETRY_DELAY_SEC=60.0
GECKOTERMINAL_FULL_OUTPUT_DIR=/home/ubuntu/norabt/nora/data/dex
GECKOTERMINAL_FULL_TARGETS_FILE=/home/ubuntu/norabt/nora/data/_meta/geckoterminal_targets.json
GECKOTERMINAL_FULL_LIMIT=500
GECKOTERMINAL_FULL_PAGE_DELAY_SEC=12.0
GECKOTERMINAL_FULL_ASSET_DELAY_SEC=60.0
GECKOTERMINAL_FULL_MAX_PAGES=30
GECKOTERMINAL_FULL_MINUTE_MAX_PAGES=400
GECKOTERMINAL_FULL_CHECKPOINT_EVERY_PAGES=5
GECKOTERMINAL_FULL_MINUTE_AGGREGATES=1,5,10,15
# Layout: nora/data/cex/<SYM>/{1m..24h}.pkl + manifest.json (Binance) | nora/data/dex/<SYM>/... (+ ticks.parquet) | nora/data/_meta (targets)
