# Mẫu unit EDU API Nora (user service). Điền @NORA_DIR@ / @NORA_PYTHON@ bằng ops/install_user_units.sh.
# Nằm trong nora.slice (ngân sách chung 12G); EDU API dùng <1G RAM bình thường.
[Unit]
Description=Nora EDU API (uvicorn :18020)
After=network.target

[Service]
Slice=nora.slice
WorkingDirectory=@NORA_DIR@
EnvironmentFile=-%h/.config/nora/app.env
EnvironmentFile=-%h/.config/nora/llm.env
Environment=PYTHONPATH=@NORA_DIR@ PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NORA_CANDLE_CACHE_MB=256 NORA_DATA_CACHE_MB=256
ExecStart=@NORA_PYTHON@ -m uvicorn backend.apps.edu:app --host 127.0.0.1 --port 18020
Nice=5
MemoryMax=2G
MemoryHigh=1500M
MemorySwapMax=0
Restart=on-failure
RestartSec=5
# EDU API không launch live bot; job backtest edu là tiến trình con độc lập.
KillMode=process

[Install]
WantedBy=default.target
