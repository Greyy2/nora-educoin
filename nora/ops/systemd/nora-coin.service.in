# Mẫu unit COIN API Nora (user service). Điền @NORA_DIR@ / @NORA_PYTHON@ bằng ops/install_user_units.sh.
# Nằm trong nora.slice (ngân sách chung 12G); COIN API + live bot supervision dùng nhiều RAM hơn EDU.
[Unit]
Description=Nora COIN API (uvicorn :18010)
After=network.target

[Service]
Slice=nora.slice
WorkingDirectory=@NORA_DIR@
EnvironmentFile=-%h/.config/nora/okx.env
EnvironmentFile=-%h/.config/nora/app.env
EnvironmentFile=-%h/.config/nora/llm.env
Environment=PYTHONPATH=@NORA_DIR@ PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NORA_CANDLE_CACHE_MB=512 NORA_DATA_CACHE_MB=512
ExecStart=@NORA_PYTHON@ -m uvicorn backend.apps.coin:app --host 127.0.0.1 --port 18010
Nice=0
MemorySwapMax=0
Restart=on-failure
RestartSec=5
# Job bot đang chạy là tiến trình con của API: restart/stop COIN API KHÔNG giết bot job.
# Bot đang chạy vẫn ghi out.log/result.json; API mới đọc trạng thái theo pid + dòng "exit N" của run_limited.
KillMode=process

[Install]
WantedBy=default.target
