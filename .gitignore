__MACOSX
coins/node_modules
.idea
data/
# Ngoại lệ: nora/data/ chỉ theo dõi phần định nghĩa/cấu hình của nora/data/alpha/ (ADR-P9 §4.7). Không commit: alpha/{user,funnel,book}/, market/, backtest/,
# wfa/, carlo/, live/, cache/ và symlink tạm ở đường cũ (alphas, _cache, okx, binance, ... nằm dưới nora/data/* nên đã bị chặn)
!nora/data/
nora/data/*
!nora/data/alpha/
nora/data/alpha/*
!nora/data/alpha/strategies/
!nora/data/alpha/education/
!nora/data/alpha/universes/
!nora/data/alpha/research/
!nora/data/alpha/explore/
!nora/data/alpha/testnet/
!nora/data/alpha/presets.json
!nora/data/alpha/registry.json
!nora/data/alpha/book.json
# P9.9: định nghĩa chiến lược hệ thống (Python DSL) ở nora/data/alpha/strategies/ được commit (cây data mới; hiện còn ở data/alphas/strategies/)
!nora/data/alpha/
nora/data/alpha/*
!nora/data/alpha/strategies/
nora/data/alpha/strategies/.versions/
# mã nguồn tên "data" (package Python) không phải dữ liệu: luôn theo dõi
!nora/backend/core/data/
!nora/backend/data/
# Dữ liệu thị trường Nora (hàng trăm MB): staging crawl và bộ dữ liệu cũ dùng làm tham chiếu test
nora/data_staging/
nora/data_staging_perp/
nora/test/data_legacy/
.env
.env.*
!.env.example

# Python generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node dependencies and build output -- these generic (no leading "/")
# patterns already match at any depth, so they cover Agent/frontend/
# node_modules/ (npm dependencies for the new Agent SPA project) and
# Agent/web/dist/ (that project's `bash Agent/frontend/build.sh` output,
# served by Agent/backend/web/app.py) without needing a separate, narrower
# entry for either -- verified with `git check-ignore -v Agent/frontend/
# node_modules Agent/web/dist` before relying on this comment instead of
# duplicating the patterns.
node_modules/
dist/
.vite/

# Logs and runtime output
*.log
*.pid
*.sock

# Data, databases, exports, archives
*.db
*.sqlite
*.sqlite3
*.csv
*.pkl
*.zip
*.tar
*.tar.gz

# Local secrets and keys
*private*
*id_rsa*
*id_ed25519*
*.pem
*.key

# BMAD
/_bmad
_bmad/config.user.toml
_bmad/custom/config.user.toml

# Untracked subprojects
sova/

# Kết quả nghiên cứu mô phỏng bot top OKX (sinh lại bằng run_*.py)
nora/test/scripts/okx_top10/out/

# Local temporary state
saved_ids.txt
nora/saved_ids.txt
nora/ops/backup_baseline_*/

legacy_monolith_archive/
